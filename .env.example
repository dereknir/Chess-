# 複製成 .env.local 後填值。.env.local 在 .gitignore 裡,不會被 commit。

# Neon 的 Pooled connection string。
# 注意:Neon 給的字串結尾有 &channel_binding=require,要手動拿掉——
# postgres.js 會把它當啟動參數送給伺服器,Postgres 不認得會報錯。
DATABASE_URL=postgresql://user:password@xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Discord 頻道的 webhook 網址
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# 本機開發就是 localhost:3000;部署後改成 Vercel 給的網址(推播裡的連結會用到)
APP_URL=http://localhost:3000

# Pusher Channels (即時推播，對方下完棋立刻刷新頁面)
# 註冊 https://pusher.com → Channels → 建立 app → 拿到這四個值
PUSHER_APP_ID=1234567
PUSHER_SECRET=xxxxxxxxxxxx
NEXT_PUBLIC_PUSHER_KEY=xxxxxxxxxxxx
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# 選配:設 off 就不在 Discord 推播裡放棋盤圖
# BOARD_IMAGE=off

# 選配:自架 lila-gif 服務的網址
# BOARD_IMAGE_BASE=
